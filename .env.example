# ==============================================================================
# Secrets Configuration
# ==============================================================================
# IMPORTANT: This file contains ONLY secrets (passwords, keys, tokens)
# All other configuration belongs in docker-compose.yml
# ==============================================================================

# Database
# POSTGRES_PASSWORD=your-password-here

# Redis
# REDIS_PASSWORD=your-redis-password

# ------------------------------------------------------------------------------
# LLM plane (inference-router via coding-client BaseLLMAgent).
# In-cluster default is fine; override only for local/dev or to point at a
# different OpenAI-compatible endpoint (LM Studio, Ollama, OpenAI proper, ...).
# ------------------------------------------------------------------------------
# LLM_API_BASE_URL=http://inference-router.inference-router.svc.cluster.local:8150/api
# LLM_API_KEY=
# LLM_MODE=inference_router
# LLM_API_TIMEOUT_SECONDS=300
# inference-router PROVIDERS (not models). `gemma` is a model served by the
# `pgx-local` provider, and the `claude` provider is enabled:false, so the old
# gemma,deepseek,claude chain collapsed to the single hop deepseek (no failover).
# LLM_ROUTING_DEFAULT_FALLBACK_CHAIN=pgx-local,deepseek

# GitHub (if needed)
# GITHUB_TOKEN=your-token
